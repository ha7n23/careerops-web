# Module 2 MCP endpoint used only by Next.js server code.
CAREEROPS_MCP_URL=http://127.0.0.1:8001/mcp

# Local development token used by Module 2's development gateway. Replace this
# with a real user access token in deployed environments.
CAREEROPS_MCP_ACCESS_TOKEN=careerops-local-dev-token

# Module 2 REST gateway used only by Next.js server code for evidence,
# job-analysis and final-CV workflows.
CAREEROPS_API_URL=http://127.0.0.1:8001

# Development-only fallback until an authenticated web session supplies the
# user's bearer token. Never expose this value with a NEXT_PUBLIC_ prefix.
CAREEROPS_API_ACCESS_TOKEN=careerops-local-dev-token

# OpenClaw runs with Module 2 and is called only by Next.js server routes.
# Copy OPENCLAW_GATEWAY_TOKEN from Module 2's .env. Never use NEXT_PUBLIC_.
OPENCLAW_GATEWAY_URL=http://127.0.0.1:18789
OPENCLAW_GATEWAY_TOKEN=
OPENCLAW_ASSISTANT_MODEL=openclaw/default
OPENCLAW_REQUEST_TIMEOUT_MS=120000
